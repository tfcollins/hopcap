{
  "schema": 1,
  "block": "vrt49_fhm_hop_ctrl",
  "id_word": "0x484F5032",
  "id_ascii": "HOP2",
  "version_word": "0x00010000",
  "axi_addr_width": 8,
  "clock_hz": 100000000,
  "slot_count": 8,
  "slot_encoding": "unsigned Q44.20 Hz, low word at +0, high word at +4",
  "event": "rising edge of scheduler_gpio[0] while CTRL.enable=1; slot = scheduler_gpio[3:1] (slot_source=0) or SEQ_INDEX (slot_source=1)",
  "states": {"IDLE": 0, "DRAIN": 1, "SETTLE": 2, "PUBLISH": 3, "OPEN": 4, "CLOSED": 5},
  "registers": [
    {"offset": "0x00", "name": "ID",               "access": "RO", "reset": "0x484F5032"},
    {"offset": "0x04", "name": "VERSION",          "access": "RO", "reset": "0x00010000"},
    {"offset": "0x08", "name": "CTRL_STATUS",      "access": "RW",
     "write_bits": {"0": "enable", "1": "slot_source (0=gpio[3:1], 1=sequence)", "2": "W1C: clear superseded/drain_timeout stickies and SUPERSEDED_COUNT", "3": "idle_open"},
     "read_bits":  {"2:0": "state", "3": "gate_open", "4": "superseded_sticky", "5": "drain_timeout_sticky", "8": "enable", "9": "slot_source", "11": "idle_open"},
     "reset": "enable=0 slot_source=0 idle_open=1"},
    {"offset": "0x0C", "name": "SETTLE_TICKS",     "access": "RW", "reset": "0x000007D0"},
    {"offset": "0x10", "name": "GPIO_SEEN",        "access": "RO", "bits": "[3:0] last sampled scheduler_gpio"},
    {"offset": "0x14", "name": "EPOCH",            "access": "RO", "desc": "hop epoch; increments once per accepted event; published in CIF2 info-source"},
    {"offset": "0x18", "name": "CAPTURE_TICKS",    "access": "RW", "reset": "0x00000000", "desc": "0 = stay open until next event"},
    {"offset": "0x1C", "name": "SUPERSEDED_COUNT", "access": "RO", "desc": "saturating; events that arrived before the previous hop's Context was accepted"},
    {"offset": "0x20", "name": "EVENT_COUNT",      "access": "RO"},
    {"offset": "0x24", "name": "CAPTURE_COUNT",    "access": "RO", "desc": "OPEN windows closed by CAPTURE_TICKS"},
    {"offset": "0x28", "name": "LAST_SLOT",        "access": "RO", "bits": "[2:0]"},
    {"offset": "0x2C", "name": "SEQ_SLOT_COUNT",   "access": "RW", "reset": "0x00000008", "desc": "1..8; sequence mode wraps at this count"},
    {"offset": "0x30", "name": "SEQ_INDEX",        "access": "RW", "reset": "0x00000000", "desc": "next slot in sequence mode; write to reset"},
    {"offset": "0x34", "name": "DRAIN_TIMEOUT_TICKS", "access": "RW", "reset": "0x00000000", "desc": "0 = wait forever for fabric_samples_drained"},
    {"offset": "0x40", "name": "SLOT0_LO", "access": "RW"}, {"offset": "0x44", "name": "SLOT0_HI", "access": "RW"},
    {"offset": "0x48", "name": "SLOT1_LO", "access": "RW"}, {"offset": "0x4C", "name": "SLOT1_HI", "access": "RW"},
    {"offset": "0x50", "name": "SLOT2_LO", "access": "RW"}, {"offset": "0x54", "name": "SLOT2_HI", "access": "RW"},
    {"offset": "0x58", "name": "SLOT3_LO", "access": "RW"}, {"offset": "0x5C", "name": "SLOT3_HI", "access": "RW"},
    {"offset": "0x60", "name": "SLOT4_LO", "access": "RW"}, {"offset": "0x64", "name": "SLOT4_HI", "access": "RW"},
    {"offset": "0x68", "name": "SLOT5_LO", "access": "RW"}, {"offset": "0x6C", "name": "SLOT5_HI", "access": "RW"},
    {"offset": "0x70", "name": "SLOT6_LO", "access": "RW"}, {"offset": "0x74", "name": "SLOT6_HI", "access": "RW"},
    {"offset": "0x78", "name": "SLOT7_LO", "access": "RW"}, {"offset": "0x7C", "name": "SLOT7_HI", "access": "RW"}
  ]
